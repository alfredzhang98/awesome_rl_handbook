<mxfile host="app.diagrams.net">
  <diagram name="rl-framework" id="0">
    <mxGraphModel dx="1200" dy="1100" grid="0" page="0" background="none">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="hub" value="&lt;b&gt;整本书都在做同一件事&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;在一个 MDP 上，用某种数据，反复做「评估 &amp;#8646; 改进」&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;下面六处各松开一次，就长出后面全部的方法&lt;/font&gt;"
                style="rounded=1;arcSize=12;html=1;fillColor=#f3ece3;strokeColor=#8a5a2b;fontColor=#1c1b19;fontSize=13;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="150" y="14" width="460" height="86" as="geometry"/></mxCell>

        <mxCell id="b1" value="&lt;b&gt;① 模型 P 给不给&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;给了&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　动态规划：策略评估 / 改进 / 策略迭代 / 值迭代　&lt;i&gt;第 2 课&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;不给，只能采样&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　蒙特卡罗、时序差分、SARSA、Q-learning　&lt;i&gt;第 3 课起&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;不给，但自己学一个&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　Dyna、PILCO、Dreamer——学完再回到第一行　&lt;i&gt;专题&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="134" width="680" height="89" as="geometry"/></mxCell>

        <mxCell id="b2" value="&lt;b&gt;② 评估怎么做：看多远、做几遍&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;目标看多远&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　一步（TD(0)）· n 步 · 整幕（MC）· 加权平均（TD(λ)、GAE）　&lt;i&gt;第 3 课 / Stage 1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;做几遍再改进&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　旋钮 m：1 遍是值迭代，∞ 遍是策略迭代　&lt;i&gt;第 2 课 §8.1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;只做几步不完全的评估&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　actor-critic 里的 critic　&lt;i&gt;Stage 2&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="237" width="680" height="89" as="geometry"/></mxCell>

        <mxCell id="b3" value="&lt;b&gt;③ 改进怎么做&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;对值表取 argmax&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　策略改进、值迭代——但挑动作要查 P　&lt;i&gt;第 2 课&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;对 Q 取 argmax，留一点探索&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　ε-greedy、SARSA——挑动作不再要 P　&lt;i&gt;第 4 课&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;不再取 max，沿梯度挪&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　策略梯度、A2C/A3C——连续动作只能这样　&lt;i&gt;Stage 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;给这一步套上约束&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　TRPO、PPO、GRPO——限制一次别改太多　&lt;i&gt;Stage 2&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="340" width="680" height="106" as="geometry"/></mxCell>

        <mxCell id="b4" value="&lt;b&gt;④ 数据从哪来&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;自己按当前策略采&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　on-policy：SARSA、REINFORCE、PPO——数据用一次就作废　&lt;i&gt;第 4 课 / Stage 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;用旧的、别人的&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　off-policy：Q-learning、replay buffer、重要性采样　&lt;i&gt;Stage 1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;只有固定数据集，不能再交互&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　离线 RL：BCQ、CQL、IQL　&lt;i&gt;进阶&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;怎么采才采得到&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　探索：ε-greedy、UCB、内在奖励　&lt;i&gt;进阶&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="460" width="680" height="106" as="geometry"/></mxCell>

        <mxCell id="b5" value="&lt;b&gt;⑤ 值与策略怎么表示&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;一格一个数&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　表格法——能印在纸上，收敛有保证　&lt;i&gt;第 0–4 课&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;线性组合 / 神经网络&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　值函数逼近、DQN 家族——状态可以很大甚至连续　&lt;i&gt;Stage 1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;存的是一个分布&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　C51、QR-DQN、IQN　&lt;i&gt;Stage 1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;策略本身也参数化&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　策略网络——动作连续时唯一的出路　&lt;i&gt;Stage 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#a8551f&quot; style=&quot;font-size:10.5px&quot;&gt;代价&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　函数逼近 + 自举 + off-policy 凑齐 ＝ 致命三角　&lt;i&gt;Stage 1&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="580" width="680" height="123" as="geometry"/></mxCell>

        <mxCell id="b6" value="&lt;b&gt;⑥ 奖励 r 从哪来&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;人手写&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　前面全部——仓库里那个「每走一步 −1」就是手写的　&lt;i&gt;第 0–4 课&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;从示范里反推&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　行为克隆、逆强化学习　&lt;i&gt;进阶&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;从偏好数据里学一个&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　RLHF、DPO　&lt;i&gt;专题&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a2b&quot; style=&quot;font-size:10.5px&quot;&gt;把「多探索」也写进目标&lt;/font&gt;&lt;font color=&quot;#7d7a73&quot; style=&quot;font-size:11px&quot;&gt;　最大熵 RL、SAC　&lt;i&gt;Stage 2&lt;/i&gt;&lt;/font&gt;"
                style="rounded=1;arcSize=10;html=1;fillColor=#faf9f7;strokeColor=#e5e2dc;fontColor=#1c1b19;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;"
                vertex="1" parent="1"><mxGeometry x="64" y="717" width="680" height="106" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="178"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="281"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="393"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="513"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="641"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e5e2dc;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="b6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="116"/><mxPoint x="30" y="770"/></Array></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
